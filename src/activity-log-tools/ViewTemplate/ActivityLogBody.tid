title: $:/plugins/linonetwo/activity-log-tools/ViewTemplate/ActivityLogBody

\procedure lingo-base() $:/plugins/linonetwo/activity-log-tools/language/

\procedure activity-log-columns()
[
  {
    "field": "title",
    "title": "<<lingo ActivityLog/Table/Key>>",
    "width": 250,
    "sort": "number"
  },
  {
    "field": "value",
    "title": "<<lingo ActivityLog/Table/Value>>",
    "width": "auto"
  }
]
\end

\procedure activity-log-records()
[<$list filter="[<currentTiddler>indexes[]]" variable="logKey" join=",">{"title":"<<logKey>>","value":"{{{ [<currentTiddler>getindex<logKey>] }}}"}</$list>]
\end

<$transclude $tiddler="$:/plugins/linonetwo/activity-log-tools/ViewTemplate/ActivityLogToolbar"/>

<$echarts $tiddler="$:/plugins/linonetwo/activity-log-tools/charts/ActivityTrend" logTitle=<<currentTiddler>> $height="300px"/>

<div class="tw-gamification-activity-log-body">
<$wikify name="columnsJson" text=<<activity-log-columns>>>
<$wikify name="recordsJson" text=<<activity-log-records>>>
<$basic-table
  records=<<recordsJson>>
  columns=<<columnsJson>>
  width="100%"
  height="420px"
  search="search-bar-top"
  sort="-title"
/>
</$wikify>
</$wikify>
</div>
